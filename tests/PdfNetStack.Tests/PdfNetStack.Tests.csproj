<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- .NET Framework 4.8 runs the .NET Standard 2.0 build of the library. Windows only. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!-- The library's internal polyfills are visible here through InternalsVisibleTo and shadow
         identical framework types on .NET Framework. Harmless; the framework type wins. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net48'">$(NoWarn);CS1685</NoWarn>
    <Prefer32Bit Condition="'$(TargetFramework)' == 'net48'">false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only dependency. MSTest is MIT licensed; nothing here ships in the packages. -->
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <!-- .NET Framework has no runtimes folder probing, and the ONNX Runtime package's copy rule is
       evaluated before the platform is known, so the native runtime is copied here, for a 64 bit
       test process. Without it Windows' own, older onnxruntime.dll would load. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <None Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.31.0\runtimes\win-x64\native\onnxruntime.dll" Link="onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.31.0\runtimes\win-x64\native\onnxruntime_providers_shared.dll" Link="onnxruntime_providers_shared.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfNetStack\PdfNetStack.csproj" />
    <ProjectReference Include="..\..\src\PdfNetStack.Html\PdfNetStack.Html.csproj" />
    <ProjectReference Include="..\..\src\PdfNetStack.Ocr\PdfNetStack.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- The models package's build file, as an application gets it from the package: models fetched into
       src/PdfNetStack.Ocr.Models/models are copied next to the tests, where OnnxOcrEngine.Load() looks. -->
  <Import Project="../../src/PdfNetStack.Ocr.Models/build/PdfNetStack.Ocr.Models.targets" />

  <ItemGroup>
    <!-- Generated by the scripts in tools/ (make_*_fixtures.py). -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Brotli dictionary: only the .NET Standard 2.0 library embeds it, and the managed decoder
         tests need it on every target. -->
    <None Include="..\..\src\PdfNetStack\Fonts\OpenType\BrotliDictionary.deflate" Link="Fixtures\Brotli\BrotliDictionary.deflate" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
