<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- .NET Framework 4.8 runs the .NET Standard 2.0 build of the library. Windows only. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!-- The library's internal polyfills are visible here through InternalsVisibleTo and shadow
         identical framework types on .NET Framework. Harmless; the framework type wins. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net48'">$(NoWarn);CS1685</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only dependency. MSTest is MIT licensed; nothing here ships in the packages. -->
    <PackageReference Include="MSTest" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfNetStack\PdfNetStack.csproj" />
    <ProjectReference Include="..\..\src\PdfNetStack.Html\PdfNetStack.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/make_jpeg_fixtures.py with libjpeg-turbo. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
