<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual check of trusted list reading against the live EU lists. Downloads; never run in CI
       or by the tests, and not part of the solution. Not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PdfNetStack.TrustedListCheck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfNetStack\PdfNetStack.csproj" />
  </ItemGroup>

</Project>
