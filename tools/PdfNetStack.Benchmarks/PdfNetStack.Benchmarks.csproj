<Project Sdk="Microsoft.NET.Sdk">

  <!-- Benchmarks for text extraction and HTML conversion. Not shipped, not packed, not in the
       solution: run it on demand, as the head of Program.cs shows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Benchmark-only dependency, MIT licensed. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfNetStack\PdfNetStack.csproj" />
    <ProjectReference Include="..\..\src\PdfNetStack.Html\PdfNetStack.Html.csproj" />
  </ItemGroup>

</Project>
