<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Native AOT executable for the provided.al2023 runtime. Lambda runs the file named bootstrap.
    Publish on Amazon Linux 2023 for the architecture you deploy (see README.md):
      dotnet publish -c Release -r linux-arm64 -o publish
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bootstrap</AssemblyName>
    <RootNamespace>PdfLambda</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Smaller and faster to start: no stack trace text or reflection metadata beyond what is used. -->
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="2.3.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.S3Events" Version="4.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\PdfNetStack\PdfNetStack.csproj" />
    <ProjectReference Include="..\..\..\src\PdfNetStack.Html\PdfNetStack.Html.csproj" />
  </ItemGroup>

  <!-- Lambda has no system fonts: the fonts in fonts/ ship with the function. -->
  <ItemGroup>
    <None Include="fonts\**\*" Exclude="fonts\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
