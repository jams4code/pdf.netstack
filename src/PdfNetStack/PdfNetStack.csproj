<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack</RootNamespace>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Internal helpers document only the non-obvious parameters. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <PackageId>PdfNetStack</PackageId>
    <!-- Pack fails on any change that would break code built against the published version. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <Title>PdfNetStack: PDF compression, optimization and editing for .NET</Title>
    <Description>Create, edit, compress, sign and validate PDF files in .NET. Pure C#, MIT licensed, no native binaries and no Ghostscript. Lossless compression (object streams, compressed xref streams, deduplication, font merging, Flate recompression, lossless JPEG re-encoding) with an equivalence proof on every output, plus opt-in lossy image profiles. Merge, split and reorder pages; text extraction with reading order and right to left scripts; forms, annotations and flattening; PAdES signatures with timestamps and long term validation; PDF/A-1b to PDF/A-4 and Factur-X/ZUGFeRD; JPEG, JPEG 2000, JBIG2, CCITT, TIFF, PNG, GIF, BMP and WebP images; AES-256 encryption. Opens and saves large files with bounded memory and runs in containers, AWS Lambda and Azure Functions. No dependencies on .NET 8 and later; .NET Standard 2.0 for .NET Framework 4.6.2+. Native AOT compatible. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;pdf-compression;compress-pdf;pdf-optimizer;optimize-pdf;reduce-pdf-size;pdf-library;merge-pdf;split-pdf;pdf-encryption;aes;jpeg;lossless;netstandard;aot;csharp;pdf-text-extraction;pdf-forms;digital-signature;pades;pdf-a;zugferd;factur-x;serverless;aws-lambda;azure-functions;jadev</PackageTags>
  </PropertyGroup>

  <!-- .NET Standard 2.0 (.NET Framework 4.6.2+, Mono, Unity) needs Microsoft's MIT licensed span
       polyfill. Modern targets have no dependencies at all. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- The Brotli static dictionary (RFC 7932 Appendix A, the same bytes as google/brotli's MIT
       licensed c/common/dictionary.bin), raw deflate compressed. Only the .NET Standard 2.0 build
       decodes Brotli itself; modern targets use System.IO.Compression.BrotliDecoder. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <EmbeddedResource Include="Fonts\OpenType\BrotliDictionary.deflate" LogicalName="PdfNetStack.BrotliDictionary.deflate" />
  </ItemGroup>

  <!-- Adobe's predefined CJK CMaps and CID to Unicode tables (BSD-3-Clause), one Brotli stream per
       character collection, generated by tools/make_cjk_cmaps.py and read lazily by text extraction. -->
  <ItemGroup>
    <EmbeddedResource Include="Text\Extraction\CMaps\*.br" LogicalName="PdfNetStack.CMaps.%(Filename).br" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfNetStack.Tests" />
    <InternalsVisibleTo Include="PdfNetStack.Cli" />
    <InternalsVisibleTo Include="PdfNetStack.Html" />
    <InternalsVisibleTo Include="PdfNetStack.Ocr" />
    <InternalsVisibleTo Include="PdfNetStack.Ocr.Tesseract" />
  </ItemGroup>

</Project>
