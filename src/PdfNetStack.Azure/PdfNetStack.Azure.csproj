<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack.Azure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>PdfNetStack.Azure</PackageId>
    <!-- Pack fails on any change that would break code built against the published version. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <Title>PdfNetStack.Azure: compress PDF files in Azure Blob Storage</Title>
    <Description>Azure Blob Storage pipeline for PdfNetStack: reads a source blob, writes the optimized PDF to a separate container under a content-addressed name, with a provenance sidecar. Managed identity only, no account keys. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;pdf-compression;azure;azure-blob-storage;managed-identity;jadev</PackageTags>
    <!-- Polyfills shared from the core through InternalsVisibleTo shadow identical framework types. Harmless. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);CS1685</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNetStack\PdfNetStack.csproj" />
    <!-- MIT licensed. Azure.Storage.Blobs is pinned below 12.30 because 12.30 added a dependency on
         Apache.Arrow (Apache-2.0). Review licenses before moving the pin. CI enforces the allowlist. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="[12.29.2]" />
  </ItemGroup>

</Project>
