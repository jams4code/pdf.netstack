<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack.Html</RootNamespace>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- Polyfills shared from the core through InternalsVisibleTo shadow identical framework types. Harmless. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);CS1685</NoWarn>
    <PackageId>PdfNetStack.Html</PackageId>
    <Title>PdfNetStack.Html: HTML and CSS to PDF in pure C#</Title>
    <Description>Convert HTML and CSS to PDF in .NET without a browser: an HTML5 parser, CSS cascade, block, inline, table and flex layout, paged media with headers, footers and page numbers, web fonts, right to left and Arabic text. Pure C#, MIT licensed, built on PdfNetStack. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;html-to-pdf;css;html;wkhtmltopdf-alternative;weasyprint;pdf-generation;invoice;report;jadev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNetStack\PdfNetStack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfNetStack.Tests" />
  </ItemGroup>

  <!--
    The engine uses internals of the core (shaping, line breaking, bidi), so it must ship with
    the core it was built against: the package depends on exactly that version, not that
    version or later.
  -->
  <Target Name="PinCoreVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
