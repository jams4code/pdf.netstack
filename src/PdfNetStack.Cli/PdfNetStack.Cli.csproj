<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack.Cli</RootNamespace>
    <AssemblyName>PdfNetStack.Tool</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Opt in with -p:NativeAot=true. A global PublishAot would also reach the core library's
         netstandard2.0 target, which cannot be compiled ahead of time. -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pdfnetstack</ToolCommandName>
    <PackageId>PdfNetStack.Tool</PackageId>
    <Title>pdfnetstack: compress, merge, split and encrypt PDF files from the command line</Title>
    <Description>Cross-platform command line tool to compress, optimize, merge, split, rotate, encrypt and decrypt PDF files. Lossless by default, every output verified against its source, optional JPEG quality reduction, batch mode with CSV reports. MIT licensed, no Ghostscript. Install with: dotnet tool install -g PdfNetStack.Tool. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;pdf-compression;compress-pdf;pdf-optimizer;merge-pdf;split-pdf;pdf-encryption;cli;dotnet-tool;jadev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNetStack\PdfNetStack.csproj" />
  </ItemGroup>

</Project>
