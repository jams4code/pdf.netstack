<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack.Ocr</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- Polyfills shared from the core through InternalsVisibleTo shadow identical framework types. Harmless. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);CS1685</NoWarn>
    <PackageId>PdfNetStack.Ocr</PackageId>
    <Title>PdfNetStack.Ocr: make scanned PDFs searchable</Title>
    <Description>OCR for PdfNetStack: finds the scan on each page, recognizes Latin and Arabic text with PP-OCRv5 models on ONNX Runtime, and adds an invisible text layer so the PDF can be searched and copied. Managed pre and post processing; PDF bytes never reach native code. The models ship separately in PdfNetStack.Ocr.Models. MIT licensed. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;ocr;searchable-pdf;scanned-pdf;paddleocr;onnx;arabic;jadev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNetStack\PdfNetStack.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfNetStack.Tests" />
  </ItemGroup>

  <!-- Uses core internals (the content interpreter), so it ships with exactly the core it was built against. -->
  <Target Name="PinCoreVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
