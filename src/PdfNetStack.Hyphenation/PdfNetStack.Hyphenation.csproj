<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfNetStack.Hyphenation</RootNamespace>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>PdfNetStack.Hyphenation</PackageId>
    <!-- The code is MIT; the patterns keep the terms of their sources, all in LICENSE.txt. No SPDX
         expression says exactly that. -->
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Title>PdfNetStack.Hyphenation: hyphenation patterns for PdfNetStack</Title>
    <Description>Hyphenation patterns for PdfNetStack paragraphs and PdfNetStack.Html's hyphens: auto: English (US and UK), German, French, Dutch, Spanish, Italian, Portuguese and 21 more pattern sets, all under permissive licenses, read from TeX's hyph-utf8. Each language loads on first use. Pure C#, no native binaries, Native AOT compatible. By Jamal Abdelkhalek, JADEV.</Description>
    <PackageTags>pdf;hyphenation;hyphens;liang;tex;typography;line-breaking;jadev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNetStack\PdfNetStack.csproj" />
  </ItemGroup>

  <!-- One raw deflate stream per language, generated by tools/make_hyphenation_data.py and read on first use. -->
  <ItemGroup>
    <EmbeddedResource Include="Patterns\*.deflate" LogicalName="PdfNetStack.Hyphenation.%(Filename).deflate" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
