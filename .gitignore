bin/
obj/
.vs/
.vscode/
.idea/
*.user
*.suo
TestResults/
artifacts/
*.nupkg
*.snupkg

# Never commit real-world documents. Tests build their fixtures in code, or from a generator
# script in tools/ for the one synthetic file below.
*.pdf
!tests/PdfNetStack.Tests/Fixtures/Forms/form.pdf

# Python bytecode from the fixture scripts
__pycache__/

# OCR model files: downloaded by tools/fetch_ocr_models.py, never committed. The models package
# project packs them from its models folder.
*.onnx

# Serverless samples: build output, fonts the reader adds (never committed), local secrets.
samples/serverless/*/publish/
samples/serverless/*/fonts/*
!samples/serverless/*/fonts/README.md
samples/serverless/**/local.settings.json
samples/serverless/**/.aws-sam/
